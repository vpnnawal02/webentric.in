# Copy to .env.local and fill in. Never commit .env.local.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Optional analytics (defaults to the existing GA property if unset)
NEXT_PUBLIC_GA_ID=G-WR2BRHB44H
# Careers application notifications (SMTP). If unset, applications are still
# saved to Supabase and visible in /admin — only the email is skipped.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
# Port rule: 587/25 → false (STARTTLS), 465 → true (implicit TLS).
# If unset, the correct value is derived from the port automatically.
SMTP_SECURE=false
SMTP_USER=you@example.com
SMTP_PASS=your-smtp-password-or-app-password
# SMTP_PASSWORD works too (either name is accepted)
SMTP_FROM="Webentric Careers <you@example.com>"
CAREERS_NOTIFY_EMAIL=webentric2026@gmail.com
